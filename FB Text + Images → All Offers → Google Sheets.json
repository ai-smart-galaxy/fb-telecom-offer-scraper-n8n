        "specifyBody": "json",
        "jsonBody": "{\"startUrls\":[{\"url\":\"https://www.facebook.com/groups/562170921088637\"}],\"resultsLimit\":1,\"viewOption\":\"CHRONOLOGICAL\"}",
        "options": {}
      },
      "id": "ec73f053-671f-4693-bee5-e1600b9b9454",
      "name": "Facebook Data Provider",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -2688,
        -992
      ]
    },
    {
      "parameters": {
        "jsCode": "const out = [];\n\nfor (const item of $input.all()) {\n  const p = item.json || {};\n\n  // Facebook post text\n  const text =\n    p.text ??\n    p.message ??\n    p.postText ??\n    p.content ??\n    p.description ??\n    p.caption ??\n    '';\n\n  // Facebook post information\n  const post_id =\n    p.id ??\n    p.postId ??\n    p.post_id ??\n    '';\n\n  const post_url =\n    p.facebookUrl ??\n    p.facebook_url ??\n    p.url ??\n    '';\n\n  const author =\n    p.user?.name ??\n    p.author?.name ??\n    p.author ??\n    '';\n\n  const post_date =\n    p.date ??\n    p.created_time ??\n    p.createdTime ??\n    p.time ??\n    '';\n\n  // Collect image URLs\n  const urls = [];\n\n  function addUrl(value) {\n    if (!value) return;\n\n    // Array\n    if (Array.isArray(value)) {\n      for (const v of value) {\n        addUrl(v);\n      }\n      return;\n    }\n\n    // String URL\n    if (typeof value === 'string') {\n      if (value.startsWith('http://') || value.startsWith('https://')) {\n        urls.push(value);\n      }\n      return;\n    }\n\n    // Object\n    if (typeof value === 'object') {\n      addUrl(value.url);\n      addUrl(value.imageUrl);\n      addUrl(value.image_url);\n      addUrl(value.displayUrl);\n      addUrl(value.src);\n      addUrl(value.thumbnail);\n    }\n  }\n\n  // Check all common image/media fields\n  addUrl(p.imageUrl);\n  addUrl(p.image_url);\n  addUrl(p.images);\n  addUrl(p.photos);\n  addUrl(p.media);\n  addUrl(p.attachments);\n  addUrl(p.photo);\n  addUrl(p.thumbnail);\n  addUrl(p.displayUrl);\n  addUrl(p.display_url);\n\n  // Remove duplicate URLs\n  const image_urls = [...new Set(urls)];\n\n  out.push({\n    json: {\n      post_id,\n      post_url,\n      author,\n      post_date,\n      post_text: String(text),\n      image_urls\n    }\n  });\n}\n\nreturn out;"
      },
      "id": "7f7d1d8c-5c23-43ab-944c-4f1b7ab06880",
      "name": "Normalize Post + Images",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2464,
        -992
      ]
    },
    {
      "parameters": {
        "jsCode": "const out=[]; for(const item of $input.all()){const j=item.json, imgs=Array.isArray(j.image_urls)?j.image_urls:[]; if(!imgs.length) out.push({json:{...j,image_url:'',image_index:0}}); else imgs.forEach((u,i)=>out.push({json:{...j,image_url:u,image_index:i+1}}));} return out;"
      },
