    {
      "parameters": {
        "jsCode": "const i=$input.first(); return [{json:{...i.json,prompt:`Read EVERYTHING in this Facebook post and image. Extract EVERY distinct telecom offer. Never skip or merge offers. Use only visible information. Missing fields = empty string. Return ONLY valid JSON: {\"offers\":[{\"operator\":\"\",\"offer\":\"\",\"price\":\"\",\"validity\":\"\",\"data\":\"\",\"minutes\":\"\",\"sms\":\"\",\"recharge_amount\":\"\",\"app\":\"\",\"eligibility\":\"\",\"ussd_code\":\"\",\"conditions\":\"\",\"location\":\"\",\"date\":\"\",\"other_details\":\"\"}]} If there are 50 offers, return 50 objects. Preserve Bengali text and numbers. POST TEXT:\\n${i.json.post_text||''}`}}];"
      },
      "id": "7838da5e-88db-4b03-ae36-6eed05883bd9",
      "name": "Build Vision Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1344,
        -1088
      ]
    },
    {
      "parameters": {
        "jsCode": "// Information Extractor output থেকে offers নেওয়া\nconst input = $input.first().json;\n\n// বিভিন্ন সম্ভাব্য output structure support করবে\nlet offers =\n  input.output?.offers ||\n  input.offers ||\n  input.data?.offers ||\n  [];\n\n// যদি offers array না হয়, empty array\nif (!Array.isArray(offers)) {\n  offers = [];\n}\n\n// Original Facebook post information নেওয়া\nlet source = {};\n\ntry {\n  source = $('Build Vision Prompt').first().json || {};\n} catch (e) {\n  source = {};\n}\n\n// যদি Build Vision Prompt node-এর data না পাওয়া যায়,\n// current input থেকেই নেওয়ার চেষ্টা\nconst postUrl =\n  source.post_url ||\n  source.postUrl ||\n  input.post_url ||\n  input.postUrl ||\n  '';\n\nconst postId =\n  source.post_id ||\n  source.postId ||\n  input.post_id ||\n  input.postId ||\n  '';\n\nconst sourceDate =\n  source.post_date ||\n  source.date ||\n  input.post_date ||\n  input.date ||\n  '';\n\n// প্রতিটি offer-কে আলাদা n8n item বানানো\nreturn offers.map((offer, index) => ({\n  json: {\n    operator: offer.operator || '',\n    offer: offer.offer || '',\n    price: offer.price || '',\n    validity: offer.validity || '',\n    data: offer.data || '',\n    minutes: offer.minutes || '',\n    sms: offer.sms || '',\n    recharge_amount: offer.recharge_amount || '',\n    app: offer.app || '',\n    eligibility: offer.eligibility || '',\n    ussd_code: offer.ussd_code || '',\n    conditions: offer.conditions || '',\n    location: offer.location || '',\n    date: offer.date || sourceDate || '',\n    other_details: offer.other_details || '',\n    \n    post_url: postUrl,\n    post_id: postId,\n    offer_index: index + 1\n  }\n}));"
      },
